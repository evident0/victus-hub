#!/bin/sh
# systemd-sleep hook: tell victus-hubd to park hardware before suspend
# and restore policy after resume. Runs as root. A missing daemon must
# not block suspend.
set -eu
SOCK=/run/victus-hubd/victus-hub.sock
DAEMON=/opt/victus-hub-app/current/bin/victus-hubd
[ -S "$SOCK" ] || exit 0
[ -x "$DAEMON" ] || exit 0
case "${1-}" in
	pre) cmd=prepare-sleep ;;
	post) cmd=resume ;;
	*) exit 0 ;;
esac
"$DAEMON" --socket "$SOCK" --client "$cmd" || true
