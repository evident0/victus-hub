[Unit]
Description=Victus Hub hardware control daemon
After=systemd-udevd.service systemd-logind.service

[Service]
Type=simple
ExecStart=/opt/victus-hub-app/current/bin/python -I -m victus_hubd
WorkingDirectory=/
Restart=on-failure
RestartSec=1
RuntimeDirectory=victus-hubd
RuntimeDirectoryMode=0755
StateDirectory=victus-hubd

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/victus-hubd -/sys/class/hwmon -/sys/class/leds -/sys/devices/platform/hp-wmi -/sys/devices/platform/hp-kbd-rgb -/sys/devices/platform/hp-gpu-mux -/sys/devices/system/cpu/cpufreq -/sys/devices/virtual/powercap
ReadOnlyPaths=-/usr/local/bin/ryzenadj
RestrictAddressFamilies=AF_UNIX
DeviceAllow=/dev/mem r
DeviceAllow=char-input r
DeviceAllow=char-202 rw
# NVML opens the nvidia, nvidiactl, and nvidia-caps device groups. The closed
# device policy otherwise makes GPU temperature, power, and utilization fail.
DeviceAllow=char-nvidia* rw

[Install]
WantedBy=multi-user.target
