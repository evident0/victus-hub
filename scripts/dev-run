#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=debug-level.sh
source "$ROOT_DIR/scripts/debug-level.sh"
# shellcheck source=kmod-prompts.sh
source "$ROOT_DIR/scripts/kmod-prompts.sh"

SERVICE_NAME=victus-hubd.service
SOCKET_PATH=/run/victus-hubd/victus-hub.sock
SERVICE_WAS_ACTIVE=0

if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
	SERVICE_WAS_ACTIVE=1
fi

cleanup() {
	local status=$?

	# Restore fan to auto before quitting
	if [ -S "$SOCKET_PATH" ]; then
		python3 - "$SOCKET_PATH" <<'PY' || true
import socket, sys
path = sys.argv[1]
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
    sock.settimeout(1.0)
    sock.connect(path)
    sock.sendall(b"fan-auto\n")
    sock.recv(256)
PY
	fi

	# Stop the service if we started it
	if [ "$SERVICE_WAS_ACTIVE" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
		sudo systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || true
	fi

	exit "$status"
}
trap cleanup EXIT INT TERM

cd "$ROOT_DIR"

# ── Optional: custom hp-wmi (includes MUX), RGB, ryzenadj ──
prompt_optional_components

bash "$ROOT_DIR/scripts/install" --app-only

# ── Run Qt app ──

printf '\033[1;34m── Starting Victus Hub ──\033[0m\n'
/usr/local/bin/victus-hub
