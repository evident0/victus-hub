#!/usr/bin/env bash
# Install (or reinstall) all Victus Hub components:
#   1. custom hp-wmi (includes MUX), hp-kbd-rgb, ryzenadj (AMD only)
#   2. victus-hubd daemon         (release binary + systemd service)
#   3. victus-hub program         (GTK 4 binary, same install as daemon)
#   4. .desktop entry + icon     (app-menu integration)
set -euo pipefail

APP_ONLY=0
CHECK_ONLY=0
if [ "${1:-}" = "--check" ]; then
	CHECK_ONLY=1
	shift
fi
if [ "${1:-}" = "--app-only" ]; then
	APP_ONLY=1
	shift
fi
if [ "$#" -ne 0 ]; then
	printf 'Usage: %s [--check] [--app-only]\n' "$0" >&2
	exit 2
fi

# install.sh prints this before cloning and sets VICTUS_HUB_BANNER_SHOWN.
if [ "${VICTUS_HUB_BANNER_SHOWN:-}" != 1 ]; then
	printf '\033[1;36m'
	printf '%s\n' \
		'__     _____ ____ _____ _   _ ____    _   _ _   _ ____  ' \
		'\ \   / /_ _/ ___|_   _| | | / ___|  | | | | | | | __ ) ' \
		' \ \ / / | | |     | | | | | \___ \  | |_| | | | |  _ \ ' \
		'  \ V /  | | |___  | | | |_| |___) | |  _  | |_| | |_) |' \
		'   \_/  |___\____| |_|  \___/|____/  |_| |_|\___/|____/ '
	printf '\033[0m\n'
fi

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [ -f "$ROOT_DIR/scripts/libadwaita-pkgconfig.sh" ]; then
	# shellcheck source=libadwaita-pkgconfig.sh
	source "$ROOT_DIR/scripts/libadwaita-pkgconfig.sh"
	ensure_libadwaita_pkgconfig
fi
# shellcheck source=kmod-prompts.sh
source "$ROOT_DIR/scripts/kmod-prompts.sh"
source "$ROOT_DIR/scripts/preflight.sh"
preflight "$APP_ONLY"
[ "$CHECK_ONLY" -eq 0 ] || exit 0

# Quit the tray app before replacing its environment, service, or drivers.
python3 "$ROOT_DIR/scripts/stop-gui"

SERVICE_NAME=victus-hubd.service
SERVICE_SRC="$ROOT_DIR/data/victus-hubd.service"
SERVICE_DST="/etc/systemd/system/$SERVICE_NAME"
SLEEP_SRC="$ROOT_DIR/data/victus-hub-sleep"
SLEEP_DST="/usr/lib/systemd/system-sleep/victus-hub"
SOCKET_PATH="/run/victus-hubd/victus-hub.sock"
ICON_SRC="$ROOT_DIR/victus_hub/resources/icons/logoV.png"
ICON_DST="/usr/share/icons/hicolor/1024x1024/apps/victus-hub.png"
DESKTOP_DST="/usr/share/applications/victus-hub.desktop"
DBUS_SERVICE_DST="/usr/share/dbus-1/services/io.github.evident0.VictusHub.service"

if [ "$(id -u)" -eq 0 ]; then
	SUDO=()
else
	SUDO=(sudo)
fi

# How many app trees to retain under /opt/victus-hub-app/releases.
# The release `current` points at always counts. 1 drops every older install.
VICTUS_HUB_KEEP_RELEASES="${VICTUS_HUB_KEEP_RELEASES:-1}"

prune_old_releases() {
	local keep current_target dir resolved extra index
	local -a others=()
	keep=${VICTUS_HUB_KEEP_RELEASES:-1}
	if ! [[ "$keep" =~ ^[1-9][0-9]*$ ]]; then
		printf 'VICTUS_HUB_KEEP_RELEASES must be a positive integer (got %s).\n' "$keep" >&2
		exit 1
	fi
	[ -d "$APP_DIR/releases" ] || return 0
	current_target=$(readlink -f "$APP_DIR/current" 2>/dev/null || true)
	if [ -z "$current_target" ] || [ ! -d "$current_target" ]; then
		printf 'Not removing releases; %s is not an installed release.\n' "$APP_DIR/current" >&2
		return 0
	fi
	while IFS= read -r dir; do
		[ -n "$dir" ] || continue
		[ -d "$dir" ] || continue
		resolved=$(readlink -f "$dir")
		[ "$resolved" = "$current_target" ] && continue
		case "$resolved" in
			"$APP_DIR/releases"/*) others+=("$resolved") ;;
		esac
	done < <(find "$APP_DIR/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)
	extra=$((keep - 1))
	index=0
	[ "${#others[@]}" -eq 0 ] && return 0
	for dir in "${others[@]}"; do
		if [ "$index" -lt "$extra" ]; then
			index=$((index + 1))
			continue
		fi
		printf 'Removing old release %s\n' "$dir"
		"${SUDO[@]}" rm -rf -- "$dir"
	done
}

# ── 1. Kernel modules / tools (no component prompts) ──
if [ "$APP_ONLY" -eq 0 ]; then
	install_components
fi

# ── 2. Root-owned application install ──
# Build before creating a release directory. A failed build leaves the
# previous current symlink in place and does not restart the service.
printf '\033[1;34m── Building victus-hubd daemon + victus-hub program ──\033[0m\n'
cd "$ROOT_DIR"
BUILD_DIR=$(mktemp -d /tmp/victus-hub-build.XXXXXXXX)
trap 'rm -rf -- "$BUILD_DIR"' EXIT
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_UID:-}" ]; then
	BUILD_HOME=$(getent passwd "$SUDO_UID" | cut -d: -f6)
	[ -n "$BUILD_HOME" ] || { printf 'Cannot determine build user home.\n' >&2; exit 1; }
	chown "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$BUILD_DIR"
	if [ -n "${PKG_CONFIG_PATH:-}" ]; then
		sudo -u "#$SUDO_UID" -- env HOME="$BUILD_HOME" PKG_CONFIG_PATH="$PKG_CONFIG_PATH" cargo build --locked --release --target-dir "$BUILD_DIR" --manifest-path "$ROOT_DIR/Cargo.toml"
	else
		sudo -u "#$SUDO_UID" -- env HOME="$BUILD_HOME" cargo build --locked --release --target-dir "$BUILD_DIR" --manifest-path "$ROOT_DIR/Cargo.toml"
	fi
else
	cargo build --locked --release --target-dir "$BUILD_DIR" --manifest-path "$ROOT_DIR/Cargo.toml"
fi
APP_DIR=/opt/victus-hub-app
"${SUDO[@]}" install -d -m755 "$APP_DIR/releases"
NEW_ENV=$("${SUDO[@]}" mktemp -d "$APP_DIR/releases/install.XXXXXXXX")
"${SUDO[@]}" chmod 755 "$NEW_ENV"
cleanup_install() {
	rm -rf -- "$BUILD_DIR"
	[ -z "${NEW_ENV:-}" ] || "${SUDO[@]}" rm -rf "$NEW_ENV"
	[ -z "${ICON_TMP:-}" ] || rm -rf "$ICON_TMP"
}
trap cleanup_install EXIT
"${SUDO[@]}" install -d -m755 "$NEW_ENV/bin"
"${SUDO[@]}" install -m755 "$BUILD_DIR/release/victus-hub" "$NEW_ENV/bin/victus-hub"
"${SUDO[@]}" install -m755 "$BUILD_DIR/release/victus-hubd" "$NEW_ENV/bin/victus-hubd"
"${SUDO[@]}" chown -R root:root "$NEW_ENV"
"${SUDO[@]}" chmod -R go-w "$NEW_ENV"
"${SUDO[@]}" ln -sfn "$NEW_ENV" "$APP_DIR/current.new"
"${SUDO[@]}" mv -Tf "$APP_DIR/current.new" "$APP_DIR/current"
NEW_ENV=
"${SUDO[@]}" install -d /usr/local/bin
printf '#!/bin/sh\nexec /opt/victus-hub-app/current/bin/victus-hub "$@"\n' |
	"${SUDO[@]}" tee /usr/local/bin/victus-hub >/dev/null
"${SUDO[@]}" chmod 755 /usr/local/bin/victus-hub

NEEDS_RELOAD=0
if [ ! -f "$SERVICE_DST" ] || ! cmp -s "$SERVICE_SRC" "$SERVICE_DST"; then
	printf 'Installing systemd service to %s\n' "$SERVICE_DST"
	"${SUDO[@]}" install -Dm644 "$SERVICE_SRC" "$SERVICE_DST"
	NEEDS_RELOAD=1
fi

if [ "$NEEDS_RELOAD" -eq 1 ]; then
	"${SUDO[@]}" systemctl daemon-reload
	"${SUDO[@]}" systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
fi

"${SUDO[@]}" systemctl enable "$SERVICE_NAME" >/dev/null
printf 'Installing systemd-sleep hook to %s\n' "$SLEEP_DST"
"${SUDO[@]}" install -Dm755 "$SLEEP_SRC" "$SLEEP_DST"
printf 'Starting %s...\n' "$SERVICE_NAME"
"${SUDO[@]}" systemctl restart "$SERVICE_NAME"

# Wait for a protocol response, not just a stale socket pathname.
READY=0
for _ in $(seq 1 30); do
	if "${SUDO[@]}" "$APP_DIR/current/bin/victus-hubd" --socket "$SOCKET_PATH" --client get-state >/dev/null 2>&1; then
		printf '\033[32mDaemon ready (%s)\033[0m\n' "$SOCKET_PATH"
		READY=1
		break
	fi
	sleep 0.2
done
if [ "$READY" -ne 1 ]; then
	printf 'Daemon startup failed. Inspect: journalctl -u victus-hubd -b\n' >&2
	exit 1
fi

prune_old_releases

# ── 3. Desktop entry + icon ──
printf '\033[1;34m── Installing desktop entry ──\033[0m\n'
if [ -f "$ICON_SRC" ]; then
	# Install the program's own icon (logoV) at standard hicolor sizes so the
	# .desktop Icon=victus-hub resolves crisply at every DPI/menu size.
	ICON_CONVERTER=()
	if command -v magick >/dev/null 2>&1; then
		ICON_CONVERTER=(magick)
	elif command -v convert >/dev/null 2>&1; then
		ICON_CONVERTER=(convert)
	fi
	if [ "${#ICON_CONVERTER[@]}" -gt 0 ]; then
		ICON_TMP=$(mktemp -d)
		for size in 16 22 24 32 48 64 128 256 512 1024; do
			dst="/usr/share/icons/hicolor/${size}x${size}/apps/victus-hub.png"
			printf 'Installing %sx%s icon to %s\n' "$size" "$size" "$dst"
			"${SUDO[@]}" install -d "/usr/share/icons/hicolor/${size}x${size}/apps"
			"${ICON_CONVERTER[@]}" "$ICON_SRC" -resize "${size}x${size}" "png32:$ICON_TMP/victus-hub-${size}.png"
			"${SUDO[@]}" install -Dm644 "$ICON_TMP/victus-hub-${size}.png" "$dst"
		done
	else
		# No ImageMagick — fall back to the single source size.
		printf 'Installing icon to %s\n' "$ICON_DST"
		"${SUDO[@]}" install -Dm644 "$ICON_SRC" "$ICON_DST"
	fi
	"${SUDO[@]}" gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
fi

VICTUS_HUB_BIN=/usr/local/bin/victus-hub
if [ ! -x "$VICTUS_HUB_BIN" ]; then
	printf 'victus-hub entry point not found — cannot write desktop Exec line.\n' >&2
	printf 'Rerun the installer and inspect its output.\n' >&2
	exit 1
fi
VICTUS_HUB_BIN="$(readlink -f "$VICTUS_HUB_BIN")"
printf 'Resolved victus-hub to %s\n' "$VICTUS_HUB_BIN"

printf 'Installing desktop entry to %s\n' "$DESKTOP_DST"
"${SUDO[@]}" install -d -m755 "$(dirname "$DBUS_SERVICE_DST")" "$(dirname "$DESKTOP_DST")"
"${SUDO[@]}" tee "$DESKTOP_DST" >/dev/null <<DESKTOP
[Desktop Entry]
Type=Application
Name=Victus Hub
Comment=HP Laptop Control Panel
Exec=env VICTUS_HUB_DEBUG_LEVEL=0 $VICTUS_HUB_BIN
Icon=victus-hub
Terminal=false
Categories=System;Utility;
StartupWMClass=io.github.evident0.VictusHub
DESKTOP

"${SUDO[@]}" tee "$DBUS_SERVICE_DST" >/dev/null <<DBUS
[D-BUS Service]
Name=io.github.evident0.VictusHub
Exec=env VICTUS_HUB_DEBUG_LEVEL=0 $VICTUS_HUB_BIN
DBUS
"${SUDO[@]}" chmod 644 "$DBUS_SERVICE_DST"

"${SUDO[@]}" update-desktop-database /usr/share/applications 2>/dev/null || true

printf '\033[32m── Install complete ──\033[0m\n'
if [ "$APP_ONLY" -eq 0 ]; then
	printf '  • Kernel modules: reused when current; built or repaired as needed. RGB depends on the keyboard. RyzenAdj: AMD only.\n'
else
	printf '  • Kernel modules and RyzenAdj left in place.\n'
fi
printf '  • Daemon:        %s (running)\n' "$SERVICE_NAME"
printf '  • Program:       victus-hub   (app menu or: victus-hub)\n'
if [ "$APP_ONLY" -eq 0 ]; then
	# Module installers run in subprocesses; recheck enrollment for the final summary.
	# shellcheck source=secure-boot.sh
	source "$ROOT_DIR/scripts/secure-boot.sh"
	if "${SUDO[@]}" test -f "$MOK_CERT" && command -v mokutil >/dev/null 2>&1; then
		if [[ $(LC_ALL=C mokutil --sb-state 2>/dev/null) == *'SecureBoot enabled'* ]] && \
			! "${SUDO[@]}" mokutil --test-key "$MOK_CERT" >/dev/null 2>&1; then
			secure_boot_instructions
		fi
	fi
fi
