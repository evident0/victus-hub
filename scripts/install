#!/usr/bin/env bash
# Install (or reinstall) all Victus Hub components:
#   1. custom hp-wmi (includes MUX), hp-kbd-rgb, ryzenadj (AMD only)
#   2. victus-hubd daemon         (root-owned venv + systemd service)
#   3. victus-hub program         (pip entry point, same install as daemon)
#   4. .desktop entry + icon     (app-menu integration)
set -euo pipefail

APP_ONLY=0
CHECK_ONLY=0
if [ "${1:-}" = "--check" ]; then
	CHECK_ONLY=1
	shift
fi
if [ "${1:-}" = "--app-only" ]; then
	APP_ONLY=1
	shift
fi
if [ "$#" -ne 0 ]; then
	printf 'Usage: %s [--check] [--app-only]\n' "$0" >&2
	exit 2
fi

# install.sh prints this before cloning and sets VICTUS_HUB_BANNER_SHOWN.
if [ "${VICTUS_HUB_BANNER_SHOWN:-}" != 1 ]; then
	printf '\033[1;36m'
	printf '%s\n' \
		'__     _____ ____ _____ _   _ ____    _   _ _   _ ____  ' \
		'\ \   / /_ _/ ___|_   _| | | / ___|  | | | | | | | __ ) ' \
		' \ \ / / | | |     | | | | | \___ \  | |_| | | | |  _ \ ' \
		'  \ V /  | | |___  | | | |_| |___) | |  _  | |_| | |_) |' \
		'   \_/  |___\____| |_|  \___/|____/  |_| |_|\___/|____/ '
	printf '\033[0m\n'
fi

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=kmod-prompts.sh
source "$ROOT_DIR/scripts/kmod-prompts.sh"
source "$ROOT_DIR/scripts/preflight.sh"
preflight "$APP_ONLY"
[ "$CHECK_ONLY" -eq 0 ] || exit 0

SERVICE_NAME=victus-hubd.service
SERVICE_SRC="$ROOT_DIR/data/victus-hubd.service"
SERVICE_DST="/etc/systemd/system/$SERVICE_NAME"
SLEEP_SRC="$ROOT_DIR/data/victus-hub-sleep"
SLEEP_DST="/usr/lib/systemd/system-sleep/victus-hub"
SOCKET_PATH="/run/victus-hubd/victus-hub.sock"
ICON_SRC="$ROOT_DIR/victus_hub/resources/icons/logoV.png"
ICON_DST="/usr/share/icons/hicolor/1024x1024/apps/victus-hub.png"
DESKTOP_DST="/usr/share/applications/victus-hub.desktop"

if [ "$(id -u)" -eq 0 ]; then
	SUDO=()
else
	SUDO=(sudo)
fi

# ── 1. Kernel modules / tools (no component prompts) ──
if [ "$APP_ONLY" -eq 0 ]; then
	install_components
fi

# ── 2. Root-owned isolated application install (no system pip writes) ──
printf '\033[1;34m── Installing victus-hubd daemon + victus-hub program ──\033[0m\n'
cd "$ROOT_DIR"
APP_DIR=/opt/victus-hub-app
"${SUDO[@]}" install -d -m755 "$APP_DIR/releases"
NEW_ENV=$("${SUDO[@]}" mktemp -d "$APP_DIR/releases/install.XXXXXXXX")
"${SUDO[@]}" chmod 755 "$NEW_ENV"
cleanup_install() {
	[ -z "${NEW_ENV:-}" ] || "${SUDO[@]}" rm -rf "$NEW_ENV"
	[ -z "${ICON_TMP:-}" ] || rm -rf "$ICON_TMP"
}
trap cleanup_install EXIT
"${SUDO[@]}" /usr/bin/python3 -I -m venv "$NEW_ENV"
"${SUDO[@]}" "$NEW_ENV/bin/python" -I -m pip install --upgrade --disable-pip-version-check "$ROOT_DIR"
# Verify imports using the exact interpreter used by the service/launcher.
"${SUDO[@]}" "$NEW_ENV/bin/python" -I -c 'from victus_hubd import daemon; from victus_hub.main import main'
"${SUDO[@]}" chown -R root:root "$NEW_ENV"
"${SUDO[@]}" chmod -R go-w "$NEW_ENV"
"${SUDO[@]}" ln -sfn "$NEW_ENV" "$APP_DIR/current.new"
"${SUDO[@]}" mv -Tf "$APP_DIR/current.new" "$APP_DIR/current"
NEW_ENV=
"${SUDO[@]}" install -d /usr/local/bin
printf '#!/bin/sh\nexec /opt/victus-hub-app/current/bin/python -I -m victus_hub "$@"\n' |
	"${SUDO[@]}" tee /usr/local/bin/victus-hub >/dev/null
"${SUDO[@]}" chmod 755 /usr/local/bin/victus-hub

TMP_UNIT=$(mktemp)
cp "$SERVICE_SRC" "$TMP_UNIT"

NEEDS_RELOAD=0
if [ ! -f "$SERVICE_DST" ] || ! cmp -s "$TMP_UNIT" "$SERVICE_DST"; then
	printf 'Installing systemd service to %s\n' "$SERVICE_DST"
	"${SUDO[@]}" install -Dm644 "$TMP_UNIT" "$SERVICE_DST"
	NEEDS_RELOAD=1
fi
rm -f "$TMP_UNIT"

if [ "$NEEDS_RELOAD" -eq 1 ]; then
	"${SUDO[@]}" systemctl daemon-reload
	"${SUDO[@]}" systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
fi

"${SUDO[@]}" systemctl enable "$SERVICE_NAME" >/dev/null
printf 'Installing systemd-sleep hook to %s\n' "$SLEEP_DST"
"${SUDO[@]}" install -Dm755 "$SLEEP_SRC" "$SLEEP_DST"
printf 'Starting %s...\n' "$SERVICE_NAME"
"${SUDO[@]}" systemctl restart "$SERVICE_NAME"

# Wait for a protocol response, not just a stale socket pathname.
READY=0
for _ in $(seq 1 30); do
	if "${SUDO[@]}" "$APP_DIR/current/bin/python" -I -c 'from victus_hub.backend.daemon_client import request_get_state; request_get_state()' 2>/dev/null; then
		printf '\033[32mDaemon ready (%s)\033[0m\n' "$SOCKET_PATH"
		READY=1
		break
	fi
	sleep 0.2
done
if [ "$READY" -ne 1 ]; then
	printf 'Daemon startup failed. Inspect: journalctl -u victus-hubd -b\n' >&2
	exit 1
fi

# ── 3. Desktop entry + icon ──
printf '\033[1;34m── Installing desktop entry ──\033[0m\n'
if [ -f "$ICON_SRC" ]; then
	# Install the program's own icon (logoV) at standard hicolor sizes so the
	# .desktop Icon=victus-hub resolves crisply at every DPI/menu size.
	ICON_CONVERTER=()
	if command -v magick >/dev/null 2>&1; then
		ICON_CONVERTER=(magick)
	elif command -v convert >/dev/null 2>&1; then
		ICON_CONVERTER=(convert)
	fi
	if [ "${#ICON_CONVERTER[@]}" -gt 0 ]; then
		ICON_TMP=$(mktemp -d)
		for size in 16 22 24 32 48 64 128 256 512 1024; do
			dst="/usr/share/icons/hicolor/${size}x${size}/apps/victus-hub.png"
			printf 'Installing %sx%s icon to %s\n' "$size" "$size" "$dst"
			"${SUDO[@]}" install -d "/usr/share/icons/hicolor/${size}x${size}/apps"
			"${ICON_CONVERTER[@]}" "$ICON_SRC" -resize "${size}x${size}" "png32:$ICON_TMP/victus-hub-${size}.png"
			"${SUDO[@]}" install -Dm644 "$ICON_TMP/victus-hub-${size}.png" "$dst"
		done
	else
		# No ImageMagick — fall back to the single source size.
		printf 'Installing icon to %s\n' "$ICON_DST"
		"${SUDO[@]}" install -Dm644 "$ICON_SRC" "$ICON_DST"
	fi
	"${SUDO[@]}" gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
fi

VICTUS_HUB_BIN=/usr/local/bin/victus-hub
if [ ! -x "$VICTUS_HUB_BIN" ]; then
	printf 'victus-hub entry point not found — cannot write desktop Exec line.\n' >&2
	printf 'Rerun the installer and inspect its output.\n' >&2
	exit 1
fi
VICTUS_HUB_BIN="$(readlink -f "$VICTUS_HUB_BIN")"
printf 'Resolved victus-hub to %s\n' "$VICTUS_HUB_BIN"

printf 'Installing desktop entry to %s\n' "$DESKTOP_DST"
"${SUDO[@]}" tee "$DESKTOP_DST" >/dev/null <<DESKTOP
[Desktop Entry]
Type=Application
Name=Victus Hub
Comment=HP Laptop Control Panel
Exec=env QT_QPA_PLATFORM=xcb VICTUS_HUB_DEBUG_LEVEL=0 $VICTUS_HUB_BIN
Icon=victus-hub
Terminal=false
Categories=System;Utility;
DESKTOP

"${SUDO[@]}" update-desktop-database /usr/share/applications 2>/dev/null || true

printf '\033[32m── Install complete ──\033[0m\n'
if [ "$APP_ONLY" -eq 0 ]; then
	printf '  • DKMS drivers installed; RGB availability depends on the keyboard. RyzenAdj: AMD only.\n'
else
	printf '  • Kernel modules and RyzenAdj left in place.\n'
fi
printf '  • Daemon:        %s (running)\n' "$SERVICE_NAME"
printf '  • Program:       victus-hub   (app menu or: victus-hub)\n'
if [ "$APP_ONLY" -eq 0 ]; then
	# Module installers run in subprocesses; recheck enrollment for the final summary.
	# shellcheck source=secure-boot.sh
	source "$ROOT_DIR/scripts/secure-boot.sh"
	if "${SUDO[@]}" test -f "$MOK_CERT" && command -v mokutil >/dev/null 2>&1; then
		if [[ $(LC_ALL=C mokutil --sb-state 2>/dev/null) == *'SecureBoot enabled'* ]] && \
			! "${SUDO[@]}" mokutil --test-key "$MOK_CERT" >/dev/null 2>&1; then
			secure_boot_instructions
		fi
	fi
fi
