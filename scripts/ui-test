#!/usr/bin/env bash
# Offline UI preview. Does not stop, disable, or talk to the installed daemon.
set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"
exec env VICTUS_HUB_EMULATE_ZONES=4 VICTUS_HUB_OFFLINE=1 VICTUS_HUB_NO_DBUS=1 cargo run --release -p victus-hub
