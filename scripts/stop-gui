#!/usr/bin/env python3
"""Stop Victus Hub instances on active user buses before replacing installed files."""

import os
import pwd
import re
import select
import signal
import subprocess
import sys
from pathlib import Path


def main():
    runtime = Path("/run/user")
    buses = (runtime.glob("[0-9]*/bus") if os.geteuid() == 0
             else [runtime / str(os.getuid()) / "bus"])
    for bus in buses:
        if not bus.is_socket():
            continue
        uid = int(bus.parent.name)
        user = pwd.getpwuid(uid)
        result = subprocess.run(
            ["gdbus", "call", "--address", f"unix:path={bus}",
             "--dest", "org.freedesktop.DBus", "--object-path", "/org/freedesktop/DBus",
             "--method", "org.freedesktop.DBus.GetConnectionUnixProcessID",
             "io.github.evident0.VictusHub"],
            capture_output=True, text=True, timeout=5,
            **({"user": uid, "group": user.pw_gid, "extra_groups": []}
               if os.geteuid() == 0 and uid != 0 else {}),
        )
        if result.returncode and "NameHasNoOwner" not in result.stderr:
            raise RuntimeError(f"Could not query session bus for user {uid}: {result.stderr.strip()}")
        match = re.search(r"uint32 (\d+)", result.stdout) if result.returncode == 0 else None
        if match is None:
            if result.returncode:
                continue  # No GUI owns the name on this bus.
            raise RuntimeError(f"Unexpected session bus reply for user {uid}: {result.stdout.strip()}")
        pid = int(match.group(1))
        try:
            fd = os.pidfd_open(pid)
        except ProcessLookupError:
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                raise RuntimeError(f"D-Bus owner {pid} does not belong to user {uid}")
            print(f"Closing Victus Hub GUI (PID {pid})...")
            signal.pidfd_send_signal(fd, signal.SIGTERM)
            if not select.select([fd], [], [], 10)[0]:
                raise RuntimeError(f"Victus Hub GUI {pid} did not exit within 10 seconds")
        except ProcessLookupError:
            pass
        finally:
            os.close(fd)


if __name__ == "__main__":
    try:
        main()
    except (OSError, KeyError, RuntimeError, subprocess.TimeoutExpired) as exc:
        sys.exit(f"Could not close Victus Hub GUI: {exc}")
