#!/usr/bin/env bash
set -euo pipefail

MODULE_NAME="hp-kbd-rgb"
MODULE_SYS_NAME="hp_kbd_rgb"
KERNEL_RELEASE="$(uname -r)"
AUTOLOAD_CONF="/etc/modules-load.d/${MODULE_NAME}.conf"

if [ "$(id -u)" -eq 0 ]; then
  SUDO=()
else
  SUDO=(sudo)
fi

if [ -d "/sys/module/${MODULE_SYS_NAME}" ]; then
  printf 'Unloading %s...\n' "$MODULE_NAME"
  "${SUDO[@]}" modprobe -r "$MODULE_NAME" || "${SUDO[@]}" rmmod "$MODULE_SYS_NAME"
fi

if [ -f "$AUTOLOAD_CONF" ]; then
  printf 'Removing autoload config: %s\n' "$AUTOLOAD_CONF"
  "${SUDO[@]}" rm -f "$AUTOLOAD_CONF"
fi

removed=0
for ko in /lib/modules/*/extra/${MODULE_NAME}.ko{,.xz,.zst,.gz}; do
  [ -f "$ko" ] || continue
  printf 'Removing installed module: %s\n' "$ko"
  "${SUDO[@]}" rm -f "$ko"
  rel="${ko#/lib/modules/}"
  "${SUDO[@]}" depmod -a "${rel%%/*}"
  removed=1
done

if [ "$removed" -eq 0 ]; then
  printf 'Updating module dependency cache...\n'
  "${SUDO[@]}" depmod -a "$KERNEL_RELEASE"
fi

printf 'Uninstalled %s.\n' "$MODULE_NAME"
