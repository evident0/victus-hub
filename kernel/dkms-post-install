#!/usr/bin/env bash
# Called by DKMS for the target kernel, including kernels not running yet.
set -euo pipefail
release=$1
module=$2
if [ "$module" = hp-wmi ]; then
	# DKMS chooses different destinations on Debian/Arch, Fedora and SUSE.
	for location in updates/dkms updates extra; do
		for file in /lib/modules/"$release"/"$location"/hp-wmi.ko{,.xz,.gz,.zst}; do
			[ -f "$file" ] || continue
			# Prefer the distro's normal DKMS priority. Unnecessary overrides
			# also trigger a slash-escaping warning in some dracut versions.
			conf="/etc/depmod.d/victus-hub-hp-wmi-$release.conf"
			rm -f "$conf"
			depmod -a "$release"
			selected=$(modinfo -k "$release" -n hp-wmi 2>/dev/null || true)
			if [ -z "$selected" ] || [ "$(readlink -f -- "$selected")" != "$(readlink -f -- "$file")" ]; then
				install -d /etc/depmod.d
				printf 'override hp-wmi %s %s\n' "$release" "$location" > "$conf"
				depmod -a "$release"
			fi
			# Avoid an old stock hp-wmi copy winning from an existing initramfs.
			if command -v update-initramfs >/dev/null 2>&1; then
				update-initramfs -u -k "$release"
			elif command -v dracut >/dev/null 2>&1; then
				dracut --force --kver "$release"
			elif command -v mkinitcpio >/dev/null 2>&1; then
				mkinitcpio -P
			fi
			exit 0
		done
	done
	printf 'DKMS hp-wmi installation for %s could not be located.\n' "$release" >&2
	exit 1
fi
