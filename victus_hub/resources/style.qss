/* Ohman panel — warm dark, one accent, IBM Plex. Tokens are @name from theme. */

QMainWindow {
    background-color: @bg;
}

QWidget#appCentral,
QScrollArea#pageScroll,
QWidget#pageViewport,
QStackedWidget#pageStack {
    background-color: @bg;
}

QWidget {
    color: @text;
    font-family: "@ui_font";
}

QScrollArea, QAbstractScrollArea {
    background-color: @bg;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: @bg;
}

QLabel {
    color: @text;
    background: transparent;
}

QPushButton {
    background-color: @pill;
    color: @text;
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: @edge;
}

QPushButton:pressed {
    background-color: @track;
}

QPushButton:disabled {
    color: @foot;
    background-color: @sunken;
}

QPushButton#accentBtn {
    background-color: @accent;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#accentBtn:hover {
    background-color: @accent_hi;
}

QPushButton#accentBtn:disabled {
    background-color: @pill;
    color: @foot;
}

QPushButton#linkBtn {
    background: transparent;
    color: @accent;
    border: none;
    padding: 0;
    font-size: 12.5px;
}

QPushButton#linkBtn:hover {
    color: @accent_hi;
    background: transparent;
}

/* slider: 2 px rail, 14 px round thumb, both in the accent */
QSlider::groove:horizontal {
    background: @track;
    height: 2px;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: @accent;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 1px;
}

QSlider::add-page:horizontal {
    background: @track;
    border-radius: 1px;
}

QSlider:disabled {
    opacity: 0.45;
}

QCheckBox {
    color: @text;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @edge;
    border-radius: 3px;
    background: @sunken;
}

QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
}

QLineEdit {
    background-color: @sunken;
    color: @text;
    border: none;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: @accent;
    font-family: "@mono_font";
    font-size: 12.5px;
}

QLineEdit:focus {
    background-color: @well;
}

QComboBox {
    background-color: @sunken;
    color: @text;
    border: none;
    border-radius: 8px;
    padding: 4px 28px 4px 10px;
    min-height: 24px;
}

QComboBox:hover {
    background-color: @pill;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow,
QComboBox::down-arrow:off,
QComboBox::down-arrow:disabled {
    image: url(icons/chevron-down.png);
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:on {
    image: url(icons/chevron-up.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: @sunken;
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @pill;
    selection-color: @text;
}

QSpinBox, QDoubleSpinBox {
    background-color: @sunken;
    color: @text;
    border: none;
    border-radius: 8px;
    padding: 4px 24px 4px 8px;
    selection-background-color: @accent;
    font-family: "@mono_font";
}

QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: @well;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: transparent;
    border: none;
    border-top-right-radius: 8px;
    width: 22px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: transparent;
    border: none;
    border-bottom-right-radius: 8px;
    width: 22px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @pill;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off,
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(icons/chevron-up.png);
    width: 14px;
    height: 14px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off,
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(icons/chevron-down.png);
    width: 14px;
    height: 14px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3B3734;
    min-height: 30px;
    border-radius: 3px;
    margin: 0 1px;
}

QScrollBar::handle:vertical:hover {
    background: @edge;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3B3734;
    min-width: 30px;
    border-radius: 3px;
    margin: 1px 0;
}

QScrollBar::handle:horizontal:hover {
    background: @edge;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QGroupBox {
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
}

QTreeWidget, QTableWidget {
    background-color: @bg;
    color: @text;
    border: none;
    gridline-color: @line2;
    outline: none;
    font-family: "@ui_font";
}

QTreeWidget::item, QTableWidget::item {
    padding: 4px 8px;
}

QTreeWidget::item:hover, QTableWidget::item:hover {
    background-color: @pill;
}

QHeaderView::section {
    background-color: @bg;
    color: @section;
    border: none;
    border-bottom: 1px solid @line2;
    padding: 6px 8px;
    font-weight: 500;
    font-size: 11px;
    font-family: "@mono_font";
}

QMenu {
    background-color: @sunken;
    color: @text;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: @text;
    padding: 6px 14px;
    border-radius: 6px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: @pill;
}

QMenu::item:disabled {
    color: @foot;
}

QMenu::separator {
    height: 1px;
    background: @line2;
    margin: 4px 8px;
}

QMessageBox {
    background-color: @bg;
}

QMessageBox QLabel {
    color: @text;
}

QColorDialog {
    background-color: @bg;
}

QToolTip {
    background-color: @sunken;
    color: @text;
    border: 1px solid @line;
    padding: 4px 8px;
}
