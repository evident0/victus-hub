/* ── Global Dark Theme ── */

QMainWindow {
    background-color: #171717;
}

QWidget#appCentral,
QScrollArea#pageScroll,
QWidget#pageViewport,
QStackedWidget#pageStack {
    background-color: #171717;
}

QWidget {
    color: #ffffff;
    font-family: "Segoe UI", "Segoe UI Variable", system-ui, sans-serif;
    font-size: 13px;
}

/* ── PushButton ── */
QPushButton {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid #373737;
    border-radius: 6px;
    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #363636;
}

QPushButton:pressed {
    background-color: #3e3e3e;
}

QPushButton:disabled {
    color: #6d6d6d;
    background-color: #242424;
}

/* ── Label ── */
QLabel {
    color: #ffffff;
    background: transparent;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    background: #303030;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #3aaeef;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #3aaeef;
    border-radius: 3px;
}

/* ── CheckBox ── */
QCheckBox {
    color: #ffffff;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 3px;
    background: #202020;
}

QCheckBox::indicator:checked {
    background: #3aaeef;
    border-color: #3aaeef;
}

/* ── LineEdit ── */
QLineEdit {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid #373737;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #3aaeef;
}

QLineEdit:focus {
    border-color: #555555;
}

/* ── ComboBox ── */
QComboBox {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid #373737;
    border-radius: 6px;
    padding: 4px 28px 4px 10px;
    min-height: 24px;
}

QComboBox:hover {
    background-color: #363636;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow,
QComboBox::down-arrow:off,
QComboBox::down-arrow:disabled {
    image: url(icons/chevron-down.png);
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:on {
    image: url(icons/chevron-up.png);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #202020;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #303030;
    selection-color: #ffffff;
}

/* ── SpinBox ── */
QSpinBox, QDoubleSpinBox {
    background-color: #303030;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 4px 24px 4px 8px;
    selection-background-color: #3aaeef;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #555555;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: transparent;
    border: none;
    border-left: 1px solid #3a3a3a;
    border-top-right-radius: 5px;
    width: 22px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: transparent;
    border: none;
    border-left: 1px solid #3a3a3a;
    border-bottom-right-radius: 5px;
    width: 22px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3a3a3a;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #444444;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off,
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(icons/chevron-up.png);
    width: 14px;
    height: 14px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off,
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(icons/chevron-down.png);
    width: 14px;
    height: 14px;
}

/* ── ScrollBar ── */
QScrollBar:vertical {
    background: #171717;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #303030;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3a3a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #171717;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #303030;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3a3a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── GroupBox ── */
QGroupBox {
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
}

/* ── TreeWidget / TableWidget ── */
QTreeWidget, QTableWidget {
    background-color: #202020;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    gridline-color: #3a3a3a;
    outline: none;
}

QTreeWidget::item, QTableWidget::item {
    padding: 4px 8px;
}

QTreeWidget::item:hover, QTableWidget::item:hover {
    background-color: #2a2a2a;
}

QHeaderView::section {
    background-color: #202020;
    color: #9d9d9d;
    border: none;
    border-bottom: 1px solid #3a3a3a;
    padding: 6px 8px;
    font-weight: bold;
    text-transform: uppercase;
}

/* ── Menu ── */
QMenu {
    background-color: #202020;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: 6px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #303030;
}

QMenu::item:disabled {
    color: #9d9d9d;
}

QMenu::item:selected:disabled {
    background-color: transparent;
    color: #9d9d9d;
}

QMenu::separator {
    height: 1px;
    background: #3a3a3a;
    margin: 4px 8px;
}

/* Sidebar button styles are set in widgets/sidebar.py for labeled nav. */
